                    {
                        "@value": "Carol Miller is a project manager focused on coordinating interdisciplinary teams and delivering successful digital transformation projects. She values clear communication and efficient planning.",
                        "@language": "en"
                    },
                    {
                        "@value": "Carol Miller ist Projektmanagerin mit Schwerpunkt auf der Koordination interdisziplinärer Teams und der erfolgreichen Umsetzung von Digitalisierungsprojekten. Sie legt großen Wert auf klare Kommunikation und effiziente Planung.",
                        "@language": "de"
                    }
                ]
