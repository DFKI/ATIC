{
    "template": {
        "$type": "array",
        "$map": {
            "@id": "?person",
            "name": "?name",
            "mail": "?em",
            "knows": {
                "$type": "array",
                "$map": {
                    "@id": "?knowsPerson",
                    "name": "?knowsPersonName"
                },
                "$where": [
                    "?person schema:knows ?knowsPerson",
                    "?knowsPerson foaf:name ?knowsPersonName"
                ],
                "$orderby": [
                    "DESC(?knowsPersonName)"
                ]
            }
        },
        "$where": [
            "?person foaf:name ?name",
            "?person schema:email ?em"
        ],
        "@context": {
            "foaf": "http://xmlns.com/foaf/0.1/",
            "schema": "https://schema.org/"
        }
    },
    "expected": [
        {
            "mail": "alice.smith@example.org",
            "name": "Alice Smith",
            "@id": "https://example.org/id/alice-smith",
            "knows": [{
                    "name": "Bob Johnson",
                    "@id": "https://example.org/id/bob-johnson"
                }]
        },
        {
            "mail": "bob.johnson@example.org",
            "name": "Bob Johnson",
            "@id": "https://example.org/id/bob-johnson",
            "knows": [
                {
                    "name": "Carol Miller",
                    "@id": "https://example.org/id/carol-miller"
                },
                {
                    "name": "Alice Smith",
                    "@id": "https://example.org/id/alice-smith"
                }
            ]
        },
        {
            "mail": "carol.miller@example.org",
            "name": "Carol Miller",
            "@id": "https://example.org/id/carol-miller",
            "knows": [{
                    "name": "Bob Johnson",
                    "@id": "https://example.org/id/bob-johnson"
                }]
        }
    ],
    "data": "data_01_bridge_persons.ttl",
    "params": {}
}
