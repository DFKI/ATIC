{
    "$map": {
        "@id": "?person",
        "desc": "?desc$string"
    },
    "$where": [
        "?person a schema:Person",
        "?person schema:description ?desc"
    ],
    "$filter": [
        "LANG(?desc) = 'en'"
    ],
    "@context": {
        "schema": "https://schema.org/"
    }
}
