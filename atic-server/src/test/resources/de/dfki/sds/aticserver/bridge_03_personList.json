{
    "$type": "array",
    "$map": {
        "@id": "?person",
        "name": "?name",
        "mail": "?em"
    },
    "$where": [
        "?person foaf:name ?name",
        "?person schema:email ?em"
    ],
    "@context": {
        "foaf": "http://xmlns.com/foaf/0.1/",
        "schema": "https://schema.org/"
    }
}
